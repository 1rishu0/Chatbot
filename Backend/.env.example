# Copy this file to .env and adjust values for local (non-Docker) development.
# Never put real secrets in this example file.

# ---------- LLM ----------
# "ollama" (local) or "groq" (cloud)
LLM_PROVIDER=ollama

OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Only needed if LLM_PROVIDER=groq
# GROQ_API_KEY=your-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# ---------- Django (only if you applied the production settings step) ----------
# SECRET_KEY=change-me
# DEBUG=True
# ALLOWED_HOSTS=127.0.0.1,localhost
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------- Database (optional) ----------
# Leave unset to use the default db.sqlite3 in the Backend folder
# SQLITE_PATH=/data/db.sqlite3